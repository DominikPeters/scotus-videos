FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PUPPETEER_SKIP_DOWNLOAD=true PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium OMP_NUM_THREADS=4 HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg poppler-utils chromium nodejs npm git g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-worker.txt /app/
RUN pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir transformers==4.57.6 torchcodec==0.7.0 pybind11 setuptools -r requirements-worker.txt \
    && pip install --no-cache-dir --no-build-isolation git+https://github.com/MahmoudAshraf97/ctc-forced-aligner.git@64293cc6d711e57666c4a8b098e9fd93b381fd88
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund puppeteer@22.15.0 \
    && npm install --global --no-audit --no-fund @openai/codex@0.162.1
COPY fetch_model.py model-files.json /app/
RUN SCOTUS_ALLOW_MODEL_DOWNLOAD=1 python fetch_model.py
COPY scotus_cloud /app/scotus_cloud
COPY render /app/render
COPY presentation /app/presentation
COPY prompts /app/prompts
COPY schemas /app/schemas
COPY tests /app/tests
COPY infra /app/infra
COPY claude-code-version.txt /app/claude-code-version.txt
RUN python /app/infra/install_research_tools.py
COPY speaker-catalog.json advocate-catalog.json editorial-profile.json /app/
COPY .workflow-release-id /app/.workflow-release-id
RUN python -m scotus_cloud.releases stamp /app
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
ENTRYPOINT ["python", "-m", "scotus_cloud.repair_bootstrap"]
