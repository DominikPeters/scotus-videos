FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir "google-auth[requests]==2.58.1" cryptography==46.0.2
COPY scotus_cloud /app/scotus_cloud
RUN python -c "import scotus_cloud.asset_publisher, google.auth"
ENTRYPOINT ["python", "-m", "scotus_cloud.asset_publisher"]
