FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-control.txt /app/
RUN pip install --no-cache-dir -r requirements-control.txt
COPY scotus_cloud /app/scotus_cloud
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "60", "scotus_cloud.control:load_app()"]
