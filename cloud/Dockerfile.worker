FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-worker.txt /app/
RUN pip install --no-cache-dir -r requirements-worker.txt
COPY scotus_cloud /app/scotus_cloud
COPY speaker-catalog.json /app/
ENTRYPOINT ["python", "-m", "scotus_cloud.worker"]
